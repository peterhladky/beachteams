# Copy to .env (git-ignored) and fill in. These two values are PUBLIC by design
# (they ship inside the app). Security comes from Row Level Security in Supabase,
# NOT from hiding these. NEVER put the Supabase service_role key anywhere in this repo.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
